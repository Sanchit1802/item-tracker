# Database Configuration (RDS)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-secure-password
DB_NAME=component_tracker

# Flask Configuration
FLASK_DEBUG=False
BASE_URL=https://your-domain.com
PORT=5000

# S3 Configuration for QR Codes
QR_S3_BUCKET=your-bucket-name
QR_S3_PREFIX=qr_codes
QR_S3_PUBLIC_READ=true

# Public Base URL for QR code links
PUBLIC_BASE_URL=https://your-domain.com
