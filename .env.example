# Database Configuration (RDS)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-secure-password
DB_NAME=component_tracker

# Flask Configuration
FLASK_DEBUG=False
PORT=5000
BASE_URL=http://your-ec2-ip:5000
PUBLIC_BASE_URL=http://your-ec2-ip:5000

# S3 Configuration for QR Codes
QR_S3_BUCKET=your-qr-bucket-name
QR_S3_PREFIX=static/qr_codes
QR_S3_PUBLIC_READ=true

# S3 Configuration for Static Assets (logo, CSS)
S3_STATIC_BUCKET=your-static-bucket-name
S3_STATIC_PREFIX=static

# AWS Credentials (use IAM role on EC2 if possible, otherwise set these)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
